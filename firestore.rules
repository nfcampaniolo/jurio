rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn() && resource.data.get('user', '') == request.auth.uid;
    }

    function isOwnerOnCreate() {
      return signedIn() && request.resource.data.get('user', '') == request.auth.uid;
    }

    function isVisibleTo() {
      return signedIn() &&
        (request.auth.uid in resource.data.get('visibleTo', []));
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function sharesTeam(targetUserData) {
      let teamId = targetUserData.get('assignedTeamId', null);
      return signedIn()
        && teamId != null
        && (
          request.auth.uid in
            get(/databases/$(database)/documents/teams/$(teamId))
              .data.get('member_ids', [])
          ||
          request.auth.uid in
            get(/databases/$(database)/documents/teams/$(teamId))
              .data.get('owners', [])
        );
    }

    function youAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/register/$(request.auth.uid))
        && get(/databases/$(database)/documents/register/$(request.auth.uid))
             .data.planId == "admin";
    }

    function youClient() {
      return signedIn()
        && exists(/databases/$(database)/documents/register/$(request.auth.uid))
        && get(/databases/$(database)/documents/register/$(request.auth.uid))
             .data.planId in [
               "admin",
               "personale",
               "prova",
               "business",
               "personale_m",
               "business_m"
             ];
    }

    function canAccessParentFascicolo(fascicoloId) {
      let fData = get(
        /databases/$(database)/documents/fascicoli/$(fascicoloId)
      ).data;

      return signedIn() && (
        fData.get('user', '') == request.auth.uid ||
        (
          fData.get('visibleTo', []) is list &&
          request.auth.uid in fData.get('visibleTo', [])
        )
      );
    }

    match /documents/{docId} {
      allow read: if isVisibleTo() || isOwner();
      allow create: if isOwnerOnCreate();
      allow update: if isOwner()
        && request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasOnly(['nome_file']);
      allow delete: if isOwner();
    }

    match /document_chunks/{chunkId} {
      allow read: if isVisibleTo() || isOwner();
      allow create: if isOwnerOnCreate();
      allow update: if false;
      allow delete: if isOwner();
    }

    match /chats/{chatId} {
      allow read, delete, update: if isOwner();
      allow create: if isOwnerOnCreate();
      match /messages/{messageId} {
        allow read, update, delete: if signedIn()
          && get(
               /databases/$(database)/documents/chats/$(chatId)
             ).data.get('user', '') == request.auth.uid;
        allow create: if signedIn()
          && get(
               /databases/$(database)/documents/chats/$(chatId)
             ).data.get('user', '') == request.auth.uid
          && isOwnerOnCreate();
      }
    }

    match /fascicoli/{fascicoloId} {
      // resource == null: i listener possono sottoscriversi a un fascicolo non ancora creato
      allow read: if signedIn() && (resource == null || isVisibleTo() || isOwner());
      allow create: if isOwnerOnCreate();
      allow update, delete: if isOwner();
      match /threads/{threadId} {
        allow read: if canAccessParentFascicolo(fascicoloId);
        allow create, update, delete: if signedIn()
          && get(
            /databases/$(database)/documents/fascicoli/$(fascicoloId)
          ).data.get('user', '') == request.auth.uid;

        match /messages/{messageId} {
          allow read: if canAccessParentFascicolo(fascicoloId);
          allow create: if signedIn()
            && get(
              /databases/$(database)/documents/fascicoli/$(fascicoloId)
            ).data.get('user', '') == request.auth.uid
            && isOwnerOnCreate();
          allow update, delete: if signedIn()
            && get(
              /databases/$(database)/documents/fascicoli/$(fascicoloId)
            ).data.get('user', '') == request.auth.uid;
        }
      }
    }

    match /users/{userId} {
      allow read: if isSelf(userId)
        || (resource != null && sharesTeam(resource.data));
      allow write: if isSelf(userId);
      match /search_terms/{termId} {
        allow read, write: if isSelf(userId);
      }
      match /savedSentenze/{savedId} {
        allow read, write: if isSelf(userId);
      }
    }

    match /meta/{document=**} {
      allow read: if signedIn();
      allow write: if youAdmin();
    }

    match /plans/{planId} {
      allow read: if true;
      allow write: if false;
    }

    match /mail/{mailId} {
      allow read: if isOwner();
      allow write: if false;
    }

    match /register/{registerId} {
      allow read: if isSelf(registerId);
      allow write: if false;
      match /prompts/{promptId} {
        allow read, delete: if isSelf(registerId);
        allow create, update: if false;
      }
      match /usage/{usageId} {
        allow read, delete: if isSelf(registerId);
        allow create, update: if false;
      }
    }

    match /sentences/{sentencesId} {
      allow read: if youClient();
      allow create: if youAdmin();
      allow update, delete: if false;
    }

    match /doctrine/{doctrineId} {
      allow read: if youClient();
      allow create: if youAdmin();
      allow update, delete: if false;
    }

    match /notification/{notificationId} {
      allow read: if isOwner();
      allow update: if isOwner() &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow create, delete: if false;
    }

    match /broadcast/{broadcastId} {
      allow read: if signedIn();
      allow write: if youAdmin();
    }

    match /logging/{logId} {
      allow read: if youAdmin();
      allow write: if false;
    }

    match /contacts/{contactId} {
      allow create: if true;
      allow read: if youAdmin();
      allow update, delete: if false;
    }

    match /metadocument/{documentId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /prompt_library/{promptId} {
      allow read: if signedIn();
      allow write: if youAdmin();
    }

    match /prompt_list/{promptId} {
      allow read: if signedIn();
      allow write: if youAdmin();
    }

    match /stripeSessions/{stripeSessionsId} {
      allow read: if isOwner();
      allow write: if false;
    }

    match /usage/{userId}/days/{dayId} {
      allow read: if isSelf(userId);
      allow write: if false;
    }

    match /teams/{teamId} {
      allow read: if signedIn() && (
        request.auth.uid in resource.data.get('member_ids', []) ||
        request.auth.uid in resource.data.get('owners', [])
      );
      allow write: if false;
      match /members/{memberId} {
        allow read: if signedIn() && (
          request.auth.uid in
            get(/databases/$(database)/documents/teams/$(teamId))
              .data.get('member_ids', []) ||
          request.auth.uid in
            get(/databases/$(database)/documents/teams/$(teamId))
              .data.get('owners', [])
        );
        allow write: if false;
      }
    }

    match /oauth_codes/{codeId} {
      allow read, update, delete: if false;
      allow create: if signedIn()
        && request.resource.data.user == request.auth.uid;
    }

    match /oauth_tokens/{tokenId} {
      allow read, write: if false;
    }

    match /deep_analysis_sessions/{sessionId} {
      allow read: if isVisibleTo() || isOwner();
      allow create: if isOwnerOnCreate()
        && !request.resource.data.keys().hasAny(['job']);
      allow update: if isOwner()
        && !request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasAny(['job']);
      allow delete: if isOwner();
    }
  }
}
