{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@word/*": [
        "../src/*"
      ]
    },
    "types": [
      "office-js",
      "node",
      "chai"
    ]
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "../src/global.d.ts",
    "../build-targets.d.ts"
  ],
  "exclude": []
}
