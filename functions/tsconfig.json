{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",         
    "skipLibCheck": true,   
    "esModuleInterop": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    "rootDir": "src",          
    "sourceMap": true,
    "strict": true,
  },
  "compileOnSave": true,
  "include": [
    "src/**/*"               
  ]
}